  processedAt             DateTime?
  failedAt                DateTime?
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt
  organization            Organization?                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfiguration   DistributionProviderConfiguration? @relation(fields: [providerConfigurationId], references: [id], onDelete: SetNull)
  releaseDelivery         ReleaseDelivery?                   @relation(fields: [releaseDeliveryId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([organizationId, processingStatus, receivedAt])
}

model ProviderExternalReference {
  id             String               @id @default(cuid())
  organizationId String
  provider       DistributionProvider
  releaseId      String
  referenceType  String
  externalId     String
