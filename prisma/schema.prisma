model User {
  id                             String                           @id @default(cuid())
  name                           String
  email                          String                           @unique
  emailVerified                  Boolean                          @default(false)
  twoFactorEnabled               Boolean?                         @default(false)
  systemRole                     UserSystemRole                   @default(USER)
  accountStatus                  UserAccountStatus                @default(ACTIVE)
  image                          String?
  username                       String?                          @unique
  usernameUpdatedAt              DateTime?
  usernameChangeAvailableAt      DateTime?
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  accounts                       Account[]
  twoFactors                     TwoFactor[]
  auditLogs                      AuditLog[]
  artistApplications             ArtistApplication[]
  reviewedArtistApplications     ArtistApplication[]              @relation("ArtistApplicationReviewer")
  artistApplicationStatusHistory ArtistApplicationStatusHistory[]
  notifications                  Notification[]
  memberships                    OrganizationMembership[]
  payoutMethods                  PayoutMethod[]
  requestedPayouts               Payout[]                         @relation("PayoutRequestedBy")
  approvedPayouts                Payout[]                         @relation("PayoutApprovedBy")
  importedRevenueImports         RevenueImport[]
  generatedRevenueReports        RevenueReport[]
  generatedRoyaltyReports        RoyaltyReport[]
  financialAdjustments           FinancialAdjustment[]            @relation("FinancialAdjustmentCreatedBy")
  beneficiaryAdjustments         FinancialAdjustment[]            @relation("FinancialAdjustmentBeneficiary")
  beneficiaryRoyaltyLines        RoyaltyLine[]
  beneficiaryFinancialStatements FinancialStatement[]
  beneficiaryPayouts             Payout[]
  billingAddresses               BillingAddress[]
  billingCustomers               BillingCustomer[]
  billingEvents                  BillingEvent[]
  couponRedemptions              CouponRedemption[]
  manualPaymentRequests          ManualPaymentRequest[]           @relation("ManualPaymentRequestUser")
  processedManualPaymentRequests ManualPaymentRequest[]           @relation("ManualPaymentRequestProcessedBy")
  paymentTransactions            PaymentTransaction[]
  refunds                        Refund[]
  subscriptions                  Subscription[]
  invoices                       Invoice[]
  comments                       Comment[]
  commentLikes                   CommentLike[]
  contentReports                 ContentReport[]                  @relation("ContentReportReporter")
  discoverEvents                 DiscoverEvent[]
  follows                        Follow[]
  moderationActions              ModerationAction[]               @relation("ModerationActionActor")
  acceptedMetadataSuggestions    MetadataSuggestion[]             @relation("MetadataSuggestionAcceptedBy")
  aiAnalysisAttempts             AiAnalysisAttempt[]
  aiAnalysisJobs                 AiAnalysisJob[]                  @relation("AiAnalysisJobRequestedBy")
  aiPromptTemplates              AiPromptTemplate[]               @relation("AiPromptTemplateCreatedBy")
  aiUsageRecords                 AiUsageRecord[]
  rejectedMetadataSuggestions    MetadataSuggestion[]             @relation("MetadataSuggestionRejectedBy")
  oauthConnections               OAuthConnection[]
  playlistCollaborations         PlaylistCollaborator[]
  playlistLikes                  PlaylistLike[]
  playlists                      Playlist[]
  preSaveConversions             PreSaveConversion[]
  preSaveSubscribers             PreSaveSubscriber[]
  releaseLikes                   ReleaseLike[]
  artistChannelLikes             ArtistChannelLike[]             @relation("ArtistChannelLikePerformer")
  externalMediaLikes             ExternalMediaLike[]
  storyViews                     StoryView[]
  trackLikes                     TrackLike[]
  userMusicPreferences           UserMusicPreference[]
  createdDistributionJobs        DistributionJob[]                @relation("DistributionJobCreatedBy")
  createdReleases                Release[]                        @relation("ReleaseCreatedBy")
  submittedReleases              Release[]                        @relation("ReleaseSubmittedBy")
  uploads                        Upload[]
  ownedArtists                   Artist[]                         @relation("ArtistOwner")
  createdArtists                 Artist[]
  createdLabels                  Label[]
  deviceSessions                 DeviceSession[]
  mobileApiRequestLogs           MobileApiRequestLog[]
  mobileDevices                  MobileDevice[]
  mobileOfflineOperations        MobileOfflineOperation[]
  mobileUploadSessions           MobileUploadSession[]
  notificationPreferences        NotificationPreference[]
  playbackSessions               PlaybackSession[]
  pushNotifications              PushNotification[]
  pushTokens                     PushToken[]
  refreshTokenFamilies           RefreshTokenFamily[]
  royaltySplits                  RoyaltySplit[]
  sessions                       Session[]
  ownedOrganizations             Organization[]                   @relation("OrganizationOwner")
  apiClients                     ApiClient[]
  apiKeys                        ApiKey[]
  webhookEndpoints               WebhookEndpoint[]
  votes                          Vote[]
  userConsents                   UserConsent[]
  cookieConsents                 CookieConsent[]
  rewardWinners                  RewardWinner[]
  usernameHistory                UserUsernameHistory[]
  importSources                  ImportSource[]
  importModerationDecisions      ImportModerationDecision[]
  deletionRequests               UserDeletionRequest[]            @relation("UserDeletionTarget")
  requestedDeletionRequests      UserDeletionRequest[]            @relation("UserDeletionRequester")
  reviewedDeletionRequests       UserDeletionRequest[]            @relation("UserDeletionReviewer")
  artistTeamMemberships          ArtistTeamMember[]
  artistDraftUpdates             ArtistProfileDraft[]             @relation("ArtistProfileDraftUpdater")
  supportTicketsRequested        SupportTicket[]                  @relation("SupportTicketRequester")
  supportTicketsAssigned         SupportTicket[]                  @relation("SupportTicketAssignee")
  supportMessages                SupportMessage[]                 @relation("SupportMessageSender")
  weeklyShareCardsCreated        WeeklyShareCard[]                @relation("WeeklyShareCardCreatedBy")
  weeklyShareCardsReviewed       WeeklyShareCard[]                @relation("WeeklyShareCardReviewedBy")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
