  cardTemplate          String       @default("PREMIUM")
  backgroundColor       String       @default("#0B0B0F")
  cardColor             String       @default("#15151C")
  buttonColor           String       @default("#E5484D")
  playerVisible         Boolean      @default(true)
  commentsEnabled       Boolean      @default(true)
  likesEnabled          Boolean      @default(true)
  dislikesEnabled       Boolean      @default(false)
  playlistEnabled       Boolean      @default(true)
  sharingEnabled        Boolean      @default(true)
  votingEnabled         Boolean      @default(true)
  rewardCampaignEnabled Boolean      @default(false)
  turkeyFilterEnabled   Boolean      @default(true)
  globalFilterEnabled   Boolean      @default(true)
