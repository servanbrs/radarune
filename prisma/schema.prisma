  @@index([active, sortOrder])
}

model PlanPrice {
  id                String             @id @default(cuid())
  planId            String
  currencyCode      CurrencyCode
  amountMinor       BigInt
  interval          BillingInterval
  intervalCount     Int                @default(1)
