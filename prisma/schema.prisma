model SupportTicket {
  id              String                @id @default(cuid())
  organizationId  String
  requesterUserId String
  assignedUserId  String?
  releaseId       String?
  subject         String                @db.VarChar(180)
  status          SupportTicketStatus   @default(OPEN)
  priority        SupportTicketPriority @default(NORMAL)
  referenceIsrc   String?
  referenceUpc    String?
  lastMessageAt   DateTime              @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester       User                  @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  assignedUser    User?                 @relation("SupportTicketAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  release         Release?              @relation(fields: [releaseId], references: [id], onDelete: SetNull)
