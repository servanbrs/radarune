  plan            SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planPrice       PlanPrice?        @relation(fields: [planPriceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Coupon {
  id               String             @id @default(cuid())
  name             String
  description      String?
  percentageOffBps Int?
  amountOffMinor   BigInt?
