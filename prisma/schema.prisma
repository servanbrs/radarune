  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  plan             SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  promotionCodes   PromotionCode[]
  redemptions      CouponRedemption[]

