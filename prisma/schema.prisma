  @@unique([organizationId, slug])
  @@index([organizationId, active, startsAt, endsAt])
}

model Vote {
  id             String            @id @default(cuid())
  campaignId     String
  organizationId String
  userId         String
  entityId       String
  entityType     ChartEntityType
