model Chart {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  chartType      ChartType
  period         ChartPeriod
  entityType     ChartEntityType
  countryCode    String?
  genreSlug      String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules          ChartRule[]
  snapshots      ChartSnapshot[]

  @@unique([organizationId, chartType, period, entityType, countryCode, genreSlug])
  @@index([organizationId, chartType, period])
}

model ChartRule {
  id              String       @id @default(cuid())
  organizationId  String
  chartId         String
  version         Int          @default(1)
  weights         Json
  fraudPenalty    Decimal      @db.Decimal(8, 4)
  diversityWeight Decimal      @db.Decimal(8, 4)
