  @@index([organizationId, status, updatedAt])
  @@index([provider, externalReleaseId])
}

model StoreDelivery {
  id                     String                      @id @default(cuid())
  releaseDeliveryId      String
  storeCode              String
  territoryCode          String?
  status                 DeliveryStatus              @default(NOT_SENT)
  externalStoreReference String?
  liveUrl                String?
  deliveredAt            DateTime?
  liveAt                 DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  releaseDelivery        ReleaseDelivery             @relation(fields: [releaseDeliveryId], references: [id], onDelete: Cascade)
  statusHistory          DistributionStatusHistory[]

  @@unique([releaseDeliveryId, storeCode, territoryCode])
  @@index([status, updatedAt])
}

model ProviderWebhookEvent {
  id                      String                             @id @default(cuid())
  organizationId          String?
  providerConfigurationId String?
  releaseDeliveryId       String?
  provider                DistributionProvider
  externalEventId         String
  processingStatus        ProviderWebhookEventStatus         @default(PENDING)
