  subscription    Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([couponId, redeemedAt])
  @@index([organizationId, redeemedAt])
  @@index([userId, redeemedAt])
}

model PaymentTransaction {
  id                     String           @id @default(cuid())
  organizationId         String?
  userId                 String?
  subscriptionId         String?
  billingCustomerId      String?
  invoiceId              String?
  provider               BillingProvider
  status                 PaymentStatus
  currencyCode           CurrencyCode
  amountMinor            BigInt
  authorizedAmountMinor  BigInt           @default(0)
  capturedAmountMinor    BigInt           @default(0)
  refundedAmountMinor    BigInt           @default(0)
  externalPaymentId      String?
  externalCheckoutId     String?
  externalInvoiceId      String?
  externalSubscriptionId String?
  description            String?
  idempotencyKey         String           @unique
  metadata               Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  authorizedAt           DateTime?
  paidAt                 DateTime?
  failedAt               DateTime?
  cancelledAt            DateTime?
  organization           Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription           Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingCustomer        BillingCustomer? @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  invoice                Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  attempts               PaymentAttempt[]
  billingEvents          BillingEvent[]
  refunds                Refund[]

  @@unique([provider, externalPaymentId])
  @@index([organizationId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([subscriptionId, createdAt])
}

model PaymentAttempt {
