  @@index([organizationId, status, issuedAt])
  @@index([userId, status, issuedAt])
}

model InvoiceLine {
  id              String            @id @default(cuid())
  invoiceId       String
  planId          String?
  planPriceId     String?
  description     String
  quantity        Int               @default(1)
  unitAmountMinor BigInt
  subtotalMinor   BigInt
  discountMinor   BigInt            @default(0)
  taxMinor        BigInt            @default(0)
  totalMinor      BigInt
