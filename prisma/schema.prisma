  chart          Chart        @relation(fields: [chartId], references: [id], onDelete: Cascade)
  entries        ChartEntry[]

  @@unique([chartId, periodStart, periodEnd])
  @@index([organizationId, calculatedAt])
}

model ChartEntry {
  id              String          @id @default(cuid())
  snapshotId      String
  organizationId  String
  rank            Int
  previousRank    Int?
  peakRank        Int?
