  createdAt         DateTime         @default(now())
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job               DistributionJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  releaseDelivery   ReleaseDelivery? @relation(fields: [releaseDeliveryId], references: [id], onDelete: SetNull)
  storeDelivery     StoreDelivery?   @relation(fields: [storeDeliveryId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([jobId, createdAt])
}

model ProviderHealthCheck {
  id                      String                             @id @default(cuid())
  organizationId          String?
  providerConfigurationId String?
  provider                DistributionProvider
  environment             ProviderEnvironment
  success                 Boolean
  responseTimeMs          Int?
  errorCode               String?
  errorMessage            String?
  checkedAt               DateTime                           @default(now())
  createdAt               DateTime                           @default(now())
  organization            Organization?                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfiguration   DistributionProviderConfiguration? @relation(fields: [providerConfigurationId], references: [id], onDelete: SetNull)

