  updatedAt           DateTime             @updatedAt
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses           BillingAddress[]
  billingEvents       BillingEvent[]
  invoices            Invoice[]
  paymentTransactions PaymentTransaction[]
  subscriptions       Subscription[]

  @@unique([provider, externalCustomerId])
  @@unique([organizationId, provider])
  @@unique([userId, provider])
  @@index([organizationId, isActive])
  @@index([userId, isActive])
}

model PaymentProviderConfig {
  id                     String          @id @default(cuid())
  organizationId         String?
  provider               BillingProvider
  active                 Boolean         @default(false)
  displayName            String?
  credentialsEncrypted   String?         @db.Text
  publicMetadata         Json?
  webhookSecretEncrypted String?         @db.Text
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  organization           Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([provider, active])
}

model Subscription {
  id                     String                 @id @default(cuid())
  organizationId         String?
  userId                 String?
  planId                 String
  priceId                String?
  billingCustomerId      String?
  scopeKey               String
  activeScopeKey         String?                @unique
  provider               BillingProvider
  status                 SubscriptionStatus
  billingInterval        BillingInterval
  currencyCode           CurrencyCode
  externalSubscriptionId String?
  externalStatus         String?
  cancelAtPeriodEnd      Boolean                @default(false)
  startedAt              DateTime
  trialStartsAt          DateTime?
  trialEndsAt            DateTime?
  currentPeriodStartsAt  DateTime?
  currentPeriodEndsAt    DateTime?
  cancelAt               DateTime?
  cancelledAt            DateTime?
  endedAt                DateTime?
  metadata               Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  organization           Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  price                  PlanPrice?             @relation(fields: [priceId], references: [id], onDelete: SetNull)
  billingCustomer        BillingCustomer?       @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  couponRedemptions      CouponRedemption[]
  invoices               Invoice[]
  items                  SubscriptionItem[]
  manualPaymentRequests  ManualPaymentRequest[]
  paymentTransactions    PaymentTransaction[]
  refunds                Refund[]
  usages                 SubscriptionUsage[]
  billingEvents          BillingEvent[]

  @@unique([provider, externalSubscriptionId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@index([scopeKey, status])
}

model SubscriptionItem {
  id              String       @id @default(cuid())
  subscriptionId  String
  planPriceId     String
  externalItemId  String?      @unique
  quantity        Int          @default(1)
  active          Boolean      @default(true)
  featureSnapshot Json?
