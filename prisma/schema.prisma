  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUser      User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  apiKeys        ApiKey[]

  @@index([organizationId, active])
  @@index([ownerUserId])
}

model ApiKey {
  id                 String           @id @default(cuid())
  apiClientId        String?
  organizationId     String
  ownerUserId        String
  name               String
  prefix             String
  keyHash            String           @unique
  scopes             Json
  rateLimitPerMinute Int              @default(60)
  ipAllowlist        Json?
  domainAllowlist    Json?
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  apiClient          ApiClient?       @relation(fields: [apiClientId], references: [id], onDelete: SetNull)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUser          User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  usageRecords       ApiUsageRecord[]

  @@index([organizationId, revokedAt])
  @@index([prefix])
  @@index([ownerUserId])
}

model ApiUsageRecord {
  id             String       @id @default(cuid())
  apiKeyId       String
  organizationId String
  requestId      String
  method         String
  path           String
  statusCode     Int
  responseTimeMs Int?
  idempotencyKey String?
  createdAt      DateTime     @default(now())
  apiKey         ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([requestId])
}

model WebhookEndpoint {
  id              String                @id @default(cuid())
  organizationId  String
  ownerUserId     String
  url             String                @db.Text
  description     String?
  secretEncrypted String                @db.Text
  active          Boolean               @default(true)
  apiVersion      String                @default("v1")
  headers         Json?
  failurePolicy   WebhookFailurePolicy  @default(RETRY)
  maxAttempts     Int                   @default(8)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUser       User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  subscriptions   WebhookSubscription[]
  deliveries      WebhookDelivery[]

  @@index([organizationId, active])
  @@index([ownerUserId])
}

model WebhookSubscription {
  id                String          @id @default(cuid())
  webhookEndpointId String
  eventType         String
  createdAt         DateTime        @default(now())
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@unique([webhookEndpointId, eventType])
  @@index([eventType])
}

model WebhookDelivery {
  id                 String                @id @default(cuid())
  webhookEndpointId  String
  organizationId     String
  eventType          String
  idempotencyKey     String
  payload            Json
  status             WebhookDeliveryStatus @default(PENDING)
