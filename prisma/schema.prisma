  updatedAt    DateTime             @updatedAt
  plan         SubscriptionPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey])
}

model BillingCustomer {
  id                  String               @id @default(cuid())
  organizationId      String?
  userId              String?
