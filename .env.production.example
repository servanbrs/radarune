NODE_ENV=production
APP_URL=https://radarune.com
NEXT_PUBLIC_APP_URL=https://radarune.com
BETTER_AUTH_URL=https://radarune.com
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Shared hosting için önce küçük ve kontrollü bir havuz kullanın. Hostinger
# panelindeki gerçek MySQL hostunu kullanın; localhost yalnızca DB aynı sunucudaysa geçerlidir.
DATABASE_CONNECTION_LIMIT=3
DATABASE_ACQUIRE_TIMEOUT_MS=60000
DATABASE_CONNECT_TIMEOUT_MS=20000
DATABASE_IDLE_TIMEOUT_SECONDS=300
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İletişim formu için güvenilir iç webhook (HTTPS)
CONTACT_WEBHOOK_URL=
# Credential ve dağıtım sırlarını şifrelemek için en az 32 karakterlik kalıcı anahtar.
ENCRYPTION_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# İsteğe bağlı: ENCRYPTION_KEY yerine webhook secret'larını ayrı şifrelemek için kullanılır.
# Seçilen anahtarı dağıtımdan sonra değiştirmeyin; eski webhook kayıtları çözülemez.
WEBHOOK_ENCRYPTION_KEY=
CRON_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEBHOOK_SIGNING_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
API_KEY_PEPPER=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
IP_HASH_SALT=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# LOCAL requires a persistent path outside the application release directory.
STORAGE_PROVIDER=LOCAL
STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true
STORAGE_LOCAL_ROOT=/var/lib/radarune/storage

# S3 uyumlu depolama (Amazon S3, Cloudflare R2, DigitalOcean Spaces veya MinIO).
# STORAGE_PROVIDER değerini S3, CLOUDFLARE_R2, DIGITALOCEAN_SPACES veya MINIO yapın.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PUBLIC_BASE_URL=

# Use NONE only when email verification is intentionally disabled by policy.
MAIL_PROVIDER=SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@radarune.com

# Optional integrations
YOUTUBE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
