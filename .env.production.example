NODE_ENV=production
APP_URL=https://radarune.com
NEXT_PUBLIC_APP_URL=https://radarune.com
BETTER_AUTH_URL=https://radarune.com
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
BETTER_AUTH_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İletişim formu için güvenilir iç webhook (HTTPS)
CONTACT_WEBHOOK_URL=
ENCRYPTION_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CRON_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEBHOOK_SIGNING_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
API_KEY_PEPPER=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
IP_HASH_SALT=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# LOCAL requires a persistent path outside the application release directory.
STORAGE_PROVIDER=LOCAL
STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true
STORAGE_LOCAL_ROOT=/var/lib/radarune/storage

# Use NONE only when email verification is intentionally disabled by policy.
MAIL_PROVIDER=SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@radarune.com

# Optional integrations
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
